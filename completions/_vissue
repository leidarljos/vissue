(( $+functions[_vissue_commands] )) ||
_vissue_commands() {
    local commands; commands=(
'create:Create an issue. Pass the body with --body or --body-file (\`-\` reads stdin); omit both to leave the body empty for a later edit' \
'q:Quick capture\: create and print only the id' \
'list:List issues, sorted by priority then state then id' \
'show:Show one issue\: metadata, then the body' \
'update:Update state, priority, or blocker edges' \
'resolve:Pick one terminal after a sibling close' \
'reject:Reject an issue, redirecting to an existing destination or a new replacement' \
'ready:Actionable issues\: TODO or STARTED with no open blocker' \
'claim:Take an issue\: move it to STARTED and stamp the claim' \
'release:Drop every live claim held by one identity. State stays' \
'vote:Cast this agent'\''s vote on an issue, or show the tally with no \`--for\`' \
'deed:Cite, drop, or list the deeds this issue'\''s work produced' \
'recall:The working set for an issue\: its plan, its inputs'\'' deeds, and its own' \
'consensus:Weigh an issue'\''s ballots by who the group listens to (DeGroot)' \
'note:Add a dated note to the top of an issue'\''s logbook; state and claim untouched' \
'append:Append a dated report to an issue'\''s body' \
'claims:Every live claim, oldest first\: who holds what, and for how long' \
'fold:Fold an inbox org file\: each unstamped \`* TODO <title>\` heading becomes an issue, then the heading is stamped with the id and flipped to DONE in place. Already-stamped headings are skipped' \
'agenda:Dated open work\: deadlines and scheduled starts inside a horizon, overdue first' \
'hygiene:Checklist for agents and CI\: stalled claims plus corpus validation' \
'whoami:Print the identity this tracker would record on a claim' \
'waiting-on:Issues waiting on this one' \
'body-excerpt:The first lines of an issue'\''s file range' \
'search:Substring search over ids, titles, properties, and bodies' \
'children:Issues whose \`\:PARENT\:\` matches this id' \
'ancestors:Blockers transitively required by this issue' \
'impact:Issues transitively waiting on this issue' \
'related:Explain bounded Org and lexical connections around an issue' \
'stale:Open issues whose \`\:CREATED\:\` is older than N days' \
'count:Print only the matching issue count' \
'export:One JSON object per issue per line' \
'tree:Children and blockers below an id' \
'cycles:Cycles in the blocker graph' \
'graph:The blocker and parent graph as Graphviz DOT' \
'satchel:Pack a slice of the tracker so somebody else can open it' \
'refile:Move an issue to another project'\''s file' \
'backlinks:Issues referring to this id' \
'roadmap:A markdown roadmap of active and closed work' \
'check:Validate the corpus. Exits non-zero on any error' \
'normalize:Rewrite files onto the Org / ELPA / vissue property split' \
'digest:A content digest of the corpus, for telling whether a copy is current' \
'project:Run the projection this repository'\''s vissue.toml declares\: fold each board'\''s inbox into its source, apply its claims file, rewrite its mirror. A source not on this machine is reported and skipped' \
'mirror:Write a read-only projection of one or more projects to a file' \
'events:Change events with a sequence above --since' \
'ping:Append a manual event, waking pollers without editing an issue' \
'wait:Block until the generation passes --last, or until an issue is terminal. Exits 2 on timeout' \
'gen:Print the current generation counter' \
'projects:List the projects found under the layout prefix' \
'surface:This binary'\''s own surface as JSON\: every subcommand, its aliases, and its long flags. Hidden; the schema checks read it' \
'identity:Print the resolved binary, root, and prefix' \
'serve:Own the per-user Unix control socket' \
'tui:Interactive board over ready, list, claims, agenda, and search' \
'hud:Task board. Default execs \`vissue-hud\`. Home is the project list' \
'completions:Write a shell completion script to stdout' \
'man:Write the roff manual page to stdout' \
'keys:Print the HUD key catalog, or check a keys.toml overlay' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'vissue commands' commands "$@"
}
